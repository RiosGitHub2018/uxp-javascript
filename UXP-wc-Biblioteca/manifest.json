{"id": "swc-uxp-starter",
  "name": "swc-uxp-starter",
  "version": "1.0.0",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0",
    "data": {
      "apiVersion": 2
    }
  },
  "featureFlags": {
    "enableAlerts": false,
    "enableSWCSupport": true,
    "CSSNextSupport": true
  },
  "main": "index.html",
  "manifestVersion": 5,
  "requiredPermissions": {
    "webview": {
      "allow": "yes",
      "domains": "all",
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localOnly"
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "http",
        "https",
        "mailto"
      ],
      "extensions": [
        "",
        ".exe",".bat", ".vbs",
        ".svg",".png", ".psb",
        ".psd",".jpeg",".jpg",
        ".tif",".txt", ".json",
        ".exe"
      ]
    },
    "ipc": {
      "enablePluginCommunication": true
    }
  },
  
  "entrypoints": [
    {
      "type": "panel",
      "id": "vanilla",
      "label": {
        "default": "SWC-UXP Starter"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_23.png",
          "scale": [1, 2],
          "theme": ["dark", "light"]
        },
        {
          "width": 32,
          "height": 32,
          "path": "icons/icon_32.png",
          "scale": [1, 2],
          "theme": ["dark", "light"]
        }
      ],
      "minimumSize": {
        "width": 230,
        "height": 200
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 230,
        "height": 900
      },
      "preferredFloatingSize": {
        "width": 230,
        "height": 900
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon_23.png",
      "scale": [1, 2],
      "theme": ["dark", "light"]
    },
    {
      "width": 32,
      "height": 32,
      "path": "icons/icon_32.png",
      "scale": [1, 2],
      "theme": ["dark", "light"]
    }
  ]
}