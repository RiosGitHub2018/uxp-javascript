{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "yarn-watch",
        "type": "shell",
        "command": "yarn",
        "args": ["watch"],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "problemMatcher": []
      }
    ]
  }
  
