{
  "id": "UXP-PSFX-RIOS",
  "name": "Ps-fxrios",
  "version": "1.0.0",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0",
    "data": {
      "apiVersion": 2
    }
  },
  "featureFlags": {
    "enableAlerts": true,
    "enableSWCSupport": true,
    "CSSNextSupport": true
  },
  "main": "index.html",
  "manifestVersion": 5,
  "requiredPermissions": {
    "webview": {
      "allow": "yes",
      "domains": "all",
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localAndRemote"
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "http",
        "https",
        "mailto"
      ],
      "extensions": [
        "",
        ".exe",".bat", ".vbs",
        ".svg",".png", ".psb",
        ".psd",".jpeg",".jpg",
        ".tif",".txt", ".json",
        ".exe"
      ]
    },
    "ipc": {
      "enablePluginCommunication": true
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "vanilla",
      "label": {
        "default": "Ps-fxrios",
        "en-US": "Ps-fxrios",
        "es-ES": "Ps-fxrios"
      },
      "minimumSize": {
        "width": 140,
        "height": 634
      },
      "maximumSize": {
        "width": 140,
        "height": 634
      },
      "preferredDockedSize": {
        "width": 140,
        "height": 634
      },
      "preferredFloatingSize": {
        "width": 140,
        "height": 634
      },
      "commands": [
        {
          "id": "show_alert",
          "label": {
            "default": "Show Alert",
            "en-US": "Show Alert (US)",
            "es-ES": "Show Alert (ES)"
          }
        }
      ],
      "icons": [
        {
          "width": 32,
          "height": 32,
          "path": "icons/light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "dark",
            "darkest"
          ],
          "species": [
            "generic"
          ]
        },
        {
          "width": 32,
          "height": 32,
          "path": "icons/dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 32,
      "height": 32,
      "path": "icons/icon_D.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "dark",
        "darkest"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 32,
      "height": 32,
      "path": "icons/icon_N.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ],
      "species": [
        "generic"
      ]
    }
  ]
}