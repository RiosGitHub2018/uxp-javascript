{
  "id": "ANTES-DEPOIS",
  "name": "Antes-Depois",
  "version": "1.0.0",
  "host": {
    "app": "PS",
    "minVersion": "24"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://source.unsplash.com"
      ]
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "request",
    "ipc": {
      "enablePluginCommunication": true
    }
  },
  "main": "index.html",
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "vanilla",
      "label": {
        "default": "Antes-Depois"
      },
      "minimumSize": {
        "width": 137,
        "height": 100
      },
      "maximumSize": {
        "width": 137,
        "height": 100
      },
      "preferredDockedSize": {
        "width": 137,
        "height": 300
      },
      "preferredFloatingSize": {
        "width": 137,
        "height": 100
      },
      "commands": [
        {
          "id": "show_alert",
          "label": {
            "default": "Show Alert",
            "en-US": "Show Alert (US)",
            "es-ES": "Show Alert (ES)"
          }
        }
      ],
      "icons": [
        {
          "width": 32,
          "height": 32,
          "path": "icons/light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "dark",
            "darkest"
          ],
          "species": [
            "generic"
          ]
        },
        {
          "width": 32,
          "height": 32,
          "path": "icons/dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 32,
      "height": 32,
      "path": "icons/icon_D.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "dark",
        "darkest"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 32,
      "height": 32,
      "path": "icons/icon_N.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ],
      "species": [
        "generic"
      ]
    }
  ]
}